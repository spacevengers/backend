# Copy to .env and edit. Never commit a real FIRMS MAP_KEY.

# --- Database (SQLite) ----------------------------------------------------
DATABASE_PATH=./data/firms.db
# Apply embedded migrations on startup.
AUTO_MIGRATE=true

# --- NASA FIRMS -----------------------------------------------------------
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov
FIRMS_TIMEOUT_SECONDS=60
FIRMS_MAX_RETRIES=4
FIRMS_REQUEST_DELAY_SECONDS=0.5
# FIRMS allows at most 5 days per area request.
FIRMS_MAX_DAYS_PER_REQUEST=5

# --- Default study area (Kenya) ------------------------------------------
DEFAULT_BBOX=33.5,-5.0,42.0,5.5

# --- API ------------------------------------------------------------------
API_ADDR=:8000
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173
EXPORT_DIR=./exports
MAX_EXPORT_ROWS=500000
SCHEMA_VERSION=0.1.0

# --- Jobs -----------------------------------------------------------------
# true makes ingestion/harmonization POSTs run inside the request. Useful for
# tests and small local runs; leave false for the server.
SYNC_JOBS=false

# --- Harmonization baseline ----------------------------------------------
HARMONIZATION_MAX_DISTANCE_KM=2.0
HARMONIZATION_MAX_TIME_MINUTES=180
HARMONIZER_METHOD=baseline
# HARMONIZER_ENDPOINT=http://ml-service:9000/harmonize
HARMONIZER_TIMEOUT_SECONDS=300
